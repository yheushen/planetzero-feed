      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        2
       ],
       "segment": {
        "start_index": 366,
        "end_index": 577,
        "part_index": null,
        "text": "**Current Reading:** KL’s official Air Pollutant Index (API) at both the **Batu Muda** and **Cheras** stations is hovering around **164** (with surrounding Selangor and Putrajaya areas between **165 and 171**)"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        2,
        3
       ],
       "segment": {
        "start_index": 581,
        "end_index": 622,
        "part_index": null,
        "text": "**Status:** **Unhealthy (API 101–200)**"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        4,
        5
       ],
       "segment": {
        "start_index": 624,
        "end_index": 719,
        "part_index": null,
        "text": "At this level, anyone can experience mild irritation (coughing, throat irritation, watery eyes)"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        4,
        5
       ],
       "segment": {
        "start_index": 624,
        "end_index": 790,
        "part_index": null,
        "text": "At this level, anyone can experience mild irritation (coughing, throat irritation, watery eyes), and children with asthma or respiratory conditions are at higher risk"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        0
       ],
       "segment": {
        "start_index": 846,
        "end_index": 979,
        "part_index": null,
        "text": "Following the policy update by Education Minister Fadhlina Sidek, the MOE reverted to the National Haze Action Plan (PTJK) thresholds"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        2,
        0
       ],
       "segment": {
        "start_index": 983,
        "end_index": 1118,
        "part_index": null,
        "text": "**API > 100 (Current level in KL):** Schools remain open, but **all outdoor activities and physical education classes must be suspended"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        6
       ],
       "segment": {
        "start_index": 1124,
        "end_index": 1219,
        "part_index": null,
        "text": "**API > 200:** Mandatory school closures and a shift to home-based teaching and learning (PdPR)"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        0,
        1
       ],
       "segment": {
        "start_index": 1223,
        "end_index": 1461,
        "part_index": null,
        "text": "**Parental Discretion:** The MOE explicitly allows parents to keep their children at home if they are worried about health risks—even if the API is below 200—as long as you **notify the school administration/class teacher in advance**"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        5,
        7
       ],
       "segment": {
        "start_index": 1523,
        "end_index": 1619,
        "part_index": null,
        "text": "Your children have asthma, allergies, bronchitis, or any underlying respiratory/heart conditions"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        8
       ],
       "segment": {
        "start_index": 1625,
        "end_index": 1758,
        "part_index": null,
        "text": "Their school has open-air classrooms without air conditioning or air purifiers, or their commute involves walking or waiting outdoors"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        5
       ],
       "segment": {
        "start_index": 1764,
        "end_index": 1843,
        "part_index": null,
        "text": "They are already showing symptoms like coughing, sore throat, or eye irritation"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        6
       ],
       "segment": {
        "start_index": 2051,
        "end_index": 2132,
        "part_index": null,
        "text": "Pack extra **clean drinking water** so they stay well-hydrated throughout the day"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        0
       ],
       "segment": {
        "start_index": 2138,
        "end_index": 2224,
        "part_index": null,
        "text": "Confirm with the school that all sports and outdoor assemblies have been moved indoors"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        6,
        8,
        7
       ],
       "segment": {
        "start_index": 2227,
        "end_index": 2482,
        "part_index": null,
        "text": "*(Note: Check the official **DOE MyIPU app** or the **APIMS website** (`apims.doe.gov.my`) on the morning of their next school day, as readings and district-level school closure notices—especially in neighboring Selangor districts—can change overnight"
       },
       "rendered_parts": null
      }
