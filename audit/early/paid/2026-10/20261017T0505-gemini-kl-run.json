       ],
       "segment": {
        "start_index": 208,
        "end_index": 305,
        "part_index": null,
        "text": "Kuala Lumpur and the wider Klang Valley are currently experiencing significant transboundary haze"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        5
       ],
       "segment": {
        "start_index": 310,
        "end_index": 444,
        "part_index": null,
        "text": "**Current Readings:** Official Air Pollutant Index (API) and real-time AQI readings in KL—specifically around **Cheras (157–179)**"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        6
       ],
       "segment": {
        "start_index": 310,
        "end_index": 474,
        "part_index": null,
        "text": "**Current Readings:** Official Air Pollutant Index (API) and real-time AQI readings in KL—specifically around **Cheras (157–179)** and **Batu Muda (156–172)**"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        7,
        8
       ],
       "segment": {
        "start_index": 310,
        "end_index": 522,
        "part_index": null,
        "text": "**Current Readings:** Official Air Pollutant Index (API) and real-time AQI readings in KL—specifically around **Cheras (157–179)** and **Batu Muda (156–172)**, as well as neighboring **Petaling Jaya (173)**"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        6,
        9,
        5
       ],
       "segment": {
        "start_index": 625,
        "end_index": 635,
        "part_index": null,
        "text": "5 sensors)"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        10
       ],
       "segment": {
        "start_index": 639,
        "end_index": 717,
        "part_index": null,
        "text": "**Health Risk:** Fine particulate matter ($PM_{2.5}$) is the primary pollutant"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        1
       ],
       "segment": {
        "start_index": 719,
        "end_index": 893,
        "part_index": null,
        "text": "Because running increases your breathing rate and depth of inhalation, exercising outdoors in these conditions pulls fine smoke particles deep into your lungs and bloodstream"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        7,
        1
       ],
       "segment": {
        "start_index": 895,
        "end_index": 1052,
        "part_index": null,
        "text": "Malaysia's Ministry of Health (MOH) has specifically advised the public to limit outdoor physical activities and wear N95 masks if going outside is necessary"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        11,
        12
       ],
       "segment": {
        "start_index": 1089,
        "end_index": 1175,
        "part_index": null,
        "text": "It is currently around **5:05 AM MYT** in Kuala Lumpur (sunrise is not until ~6:57 AM)"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        13,
        14
       ],
       "segment": {
        "start_index": 1180,
        "end_index": 1248,
        "part_index": null,
        "text": "Between the pre-dawn darkness and the thick haze reducing visibility"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        15,
        16,
        6,
        5
       ],
       "segment": {
        "start_index": 1390,
        "end_index": 1486,
        "part_index": null,
        "text": "**Morning:** It is warm and muggy (around 25°C–27°C / 78°F–80°F with ~85–88% humidity)"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        15,
        11
       ],
       "segment": {
        "start_index": 1490,
        "end_index": 1641,
        "part_index": null,
        "text": "**Later Today:** If you were hoping to wait until the sun comes up, the forecast calls for high heat and scattered thunderstorms later in the afternoon"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        17
       ],
       "segment": {
        "start_index": 1490,
        "end_index": 1721,
        "part_index": null,
        "text": "**Later Today:** If you were hoping to wait until the sun comes up, the forecast calls for high heat and scattered thunderstorms later in the afternoon, though brief rain showers haven't been enough to fully clear the haze recently"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
        18,
        17,
        19
       ],
       "segment": {
        "start_index": 1884,
        "end_index": 2121,
        "part_index": null,
        "text": "If you decide to head out in the coming days, check the official **DOE APIMS (Air Pollutant Index Management System)** portal or the **MyEQMS** app first, and wait until the API drops below 100 (Moderate) before resuming outdoor workouts"
       },
       "rendered_parts": null
      }
