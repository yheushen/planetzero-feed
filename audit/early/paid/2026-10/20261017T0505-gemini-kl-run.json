       "segment": {
        "start_index": null,
        "end_index": 69,
        "part_index": null,
        "text": "**No, it is not recommended to run outdoors in Kuala Lumpur right now"
       },
       "rendered_parts": null
      },
      {
       "confidence_scores": null,
       "grounding_chunk_indices": [
