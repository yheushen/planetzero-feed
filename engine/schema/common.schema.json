{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetzero.ai/schema/common.schema.json",
  "title": "Planet Zero feed: shared definitions",
  "description": "A number never travels without what it is: unit, scale, band, window, source, source type and the time it was measured (invariant 1). A failed fetch is a 'missing' object, never an old value (invariant 10). Times are local to Malaysia and Singapore (UTC+8).",
  "$defs": {
    "time": {
      "type": "string",
      "description": "Local time in Malaysia and Singapore, with its offset.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?\\+08:00$"
    },
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "unit": {"enum": ["µg/m³", "PSI", "API", "US AQI"]},
    "scale": {"enum": ["hourly_pm25", "psi", "api", "us_aqi"]},
    "window": {"enum": ["1h", "24h"], "description": "1h: this hour. 24h: the average of the past 24 hours."},
    "band": {"enum": ["Normal", "Elevated", "High", "Very high", "Good", "Moderate", "Unhealthy for sensitive groups", "Unhealthy", "Very unhealthy", "Hazardous"]},
    "source": {"enum": ["NEA", "DOE", "OpenAQ", "CAMS", "aqicn"], "description": "Only sources marked 'show' in docs/DATA-TERMS.md (invariant 6)."},
    "source_type": {"enum": ["government monitor", "community sensor", "computer model", "satellite"]},
    "station": {
      "type": "object",
      "required": ["id", "name", "lat", "lon"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "provider": {"type": "string"},
        "owner": {"type": "string", "description": "A community sensor's owner, credited as its licence asks."},
        "licence": {"type": "string", "description": "A community sensor's licence, as OpenAQ gives it (CC BY 4.0, CC0 1.0, or none given)."},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    },
    "reading_ok": {
      "type": "object",
      "required": ["status", "value", "unit", "scale", "band", "window", "source", "source_type", "measured_at", "station", "credit"],
      "properties": {
        "status": {"const": "ok"},
        "value": {"type": "number", "minimum": 0},
        "unit": {"$ref": "#/$defs/unit"},
        "scale": {"$ref": "#/$defs/scale"},
        "band": {"$ref": "#/$defs/band"},
        "window": {"$ref": "#/$defs/window"},
        "source": {"$ref": "#/$defs/source"},
        "source_type": {"$ref": "#/$defs/source_type"},
        "measured_at": {"$ref": "#/$defs/time"},
        "station": {"$ref": "#/$defs/station"},
        "distance_km": {"type": "number", "minimum": 0, "maximum": 10, "description": "From the place to a community sensor. Never more than 10 km (invariant 3)."},
        "credit": {"type": "string", "minLength": 1},
        "relayed_from": {"enum": ["NEA", "DOE"], "description": "For a relayed number (aqicn): whose monitor it comes from."},
        "formula": {"enum": ["us_aqi", "us_aqi_older"], "description": "For a US AQI: which of the US EPA's lines turned the µg/m³ into it (scales.json, conversions). aqicn uses the older lines on NEA's hour (part 48)."},
        "earlier": {
          "type": "object",
          "description": "For the hour: the worst reading of the same monitor or sensor in the 12 hours before, when its band was worse than now ('Check again in an hour').",
          "required": ["value", "band", "measured_at"],
          "properties": {"value": {"type": "number", "minimum": 0}, "band": {"$ref": "#/$defs/band"}, "measured_at": {"$ref": "#/$defs/time"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "missing": {
      "type": "object",
      "description": "The source was asked and did not answer, or answered with nothing usable. Shown as missing, never filled (invariant 10).",
      "required": ["status", "source", "reason", "checked_at"],
      "properties": {
        "status": {"const": "missing"},
        "source": {"$ref": "#/$defs/source"},
        "reason": {"type": "string", "minLength": 1},
        "checked_at": {"$ref": "#/$defs/time"}
      },
      "additionalProperties": false
    },
    "none": {
      "type": "object",
      "description": "There is no such number here (a Malaysian place with no open sensor within 10 km). Never invented (invariant 3).",
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "none"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "reading": {"oneOf": [{"$ref": "#/$defs/reading_ok"}, {"$ref": "#/$defs/missing"}, {"$ref": "#/$defs/none"}]},
    "place": {
      "type": "object",
      "required": ["id", "country", "name", "short", "region", "lat", "lon", "aliases", "lead", "hour_rule", "hour", "index", "nearby", "others"],
      "properties": {
        "id": {"type": "string", "pattern": "^(sg|my)-[a-z0-9]+$"},
        "country": {"enum": ["SG", "MY"]},
        "name": {"type": "string", "minLength": 1},
        "short": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "lat": {"type": "number"},
        "lon": {"type": "number"},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "lead": {"enum": ["hour", "index"], "description": "Which number is the big one. 'hour' exactly when the hour is ok (invariant 3)."},
        "hour_rule": {"enum": ["nea_region", "sensor_within_10km"]},
        "hour": {"$ref": "#/$defs/reading"},
        "index": {"oneOf": [{"$ref": "#/$defs/reading_ok"}, {"$ref": "#/$defs/missing"}]},
        "nearby": {"type": "array", "items": {"$ref": "#/$defs/reading_ok"}, "description": "The other community sensors within 10 km, same hour."},
        "others": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/reading_ok"}, {"$ref": "#/$defs/missing"}]}, "description": "Comparison rows (the 6 numbers): the computer model's estimate, and aqicn's current value where aqicn relays the place's monitor (never kept in history/)."},
        "last_24h": {
          "type": "object",
          "description": "The 24 hours up to the hour shown, for the source that leads the page, from history/ (session 6, part 52). A missing hour is null.",
          "required": ["source", "unit", "scale", "window", "station", "to", "values"],
          "properties": {
            "source": {"$ref": "#/$defs/source"},
            "unit": {"$ref": "#/$defs/unit"},
            "scale": {"$ref": "#/$defs/scale"},
            "window": {"$ref": "#/$defs/window"},
            "station": {"type": "string"},
            "to": {"$ref": "#/$defs/time"},
            "note": {"type": "string"},
            "values": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"type": ["number", "null"]}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"hour": {"properties": {"status": {"const": "ok"}}}}},
          "then": {"properties": {"lead": {"const": "hour"}}},
          "else": {"properties": {"lead": {"const": "index"}}}
        }
      ]
    }
  }
}
