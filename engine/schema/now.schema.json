{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetzero.ai/schema/now.schema.json",
  "title": "now.json: the air at every place, as of the last run",
  "type": "object",
  "required": ["schema_version", "generated_at", "sources", "places", "credits"],
  "properties": {
    "schema_version": {"const": "1"},
    "generated_at": {"$ref": "common.schema.json#/$defs/time"},
    "replay_of": {"$ref": "common.schema.json#/$defs/time", "description": "Present only in a replay: the page then says 'Replay' and runs its clock from this time."},
    "sources": {
      "type": "object",
      "description": "What each source did on this run.",
      "additionalProperties": {
        "type": "object",
        "required": ["ok", "checked_at"],
        "properties": {
          "ok": {"type": "boolean"},
          "checked_at": {"$ref": "common.schema.json#/$defs/time"},
          "error": {"type": "string"},
          "hours_added": {"type": "integer", "minimum": 0},
          "latest": {"$ref": "common.schema.json#/$defs/time"}
        },
        "additionalProperties": false
      }
    },
    "next": {
      "type": "object",
      "description": "When the page should expect each lead source's next reading, in minutes after that reading's hour: the median of the last 7 days' first-seen delays, plus our build, GitHub Pages and the 10-minute cache (session 6, part 51). A source with too few recorded hours is left out, and the page then shows no countdown.",
      "additionalProperties": {
        "type": "object",
        "required": ["after_minutes", "seen_minutes", "build_minutes", "pages_minutes", "cache_minutes", "hours", "days"],
        "properties": {
          "after_minutes": {"type": "integer", "minimum": 0},
          "seen_minutes": {"type": "integer", "minimum": 0},
          "build_minutes": {"type": "integer", "minimum": 0},
          "pages_minutes": {"type": "integer", "minimum": 0},
          "cache_minutes": {"type": "integer", "minimum": 0},
          "hours": {"type": "integer", "minimum": 1},
          "days": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "places": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/place"}},
    "credits": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}, "description": "Each source this file holds, with its required credit line (engine/schema/credits.json) and the day it was fetched."}
  },
  "additionalProperties": false
}
