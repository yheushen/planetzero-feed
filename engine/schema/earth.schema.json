{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "earth.schema.json",
  "title": "earth.json: Earth's layers (docs/SPEC.md section 27). Every layer says its kind, unit, source, credit, the time it covers and the time it was made; a missing layer says why.",
  "type": "object",
  "required": ["schema_version", "generated_at", "kinds", "layers", "credits"],
  "properties": {
    "schema_version": {"const": "1"},
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d\\+08:00$"},
    "replay_of": {"type": "string"},
    "kinds": {"type": "object", "required": ["measured", "from_space", "estimated"]},
    "layers": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/layer"}},
    "took_s": {"type": "object"},
    "credits": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "layer": {
      "type": "object",
      "required": ["id", "name", "kind", "unit", "source", "credit", "status", "made_at", "what", "colours", "updates", "numbers", "words"],
      "properties": {
        "id": {"enum": ["smoke", "wind", "fires", "monitors", "satellites", "real_earth", "smoke_space", "co"]},
        "kind": {"enum": ["measured", "from_space", "estimated"]},
        "status": {"enum": ["ok", "missing"]},
        "unit": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "credit": {"type": "string", "minLength": 1},
        "made_at": {"type": "string", "minLength": 10},
        "covers": {"type": "object", "minProperties": 1},
        "reason": {"type": "string", "minLength": 1},
        "picture": {"const": true},
        "cell_deg": {"type": "number", "exclusiveMinimum": 0},
        "cell_km": {"type": "number", "exclusiveMinimum": 0},
        "step_hours": {"type": "integer", "minimum": 1, "maximum": 24, "description": "The wind: hours between the model's steps (part 112)."},
        "day_picture": {"$ref": "#/$defs/day_picture"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "missing"}}}, "then": {"required": ["reason"]}},
        {"if": {"properties": {"status": {"const": "ok"}}}, "then": {"required": ["covers"]}},
        {"if": {"properties": {"id": {"const": "wind"}}, "required": ["id"]}, "then": {"required": ["step_hours"]}},
        {"if": {"required": ["day_picture"]}, "then": {"properties": {"id": {"const": "real_earth"}}}},
        {"if": {"properties": {"picture": {"const": true}}, "required": ["picture"]}, "then": {"properties": {"unit": {"const": "picture"}, "numbers": {"const": "Picture only"}}, "required": ["gibs"]}}
      ]
    },
    "day_picture": {
      "description": "Real Earth as 1 finished picture of the whole planet, built by the engine once a day (session 7e, parts 114 and 116): the gaps filled, the poles completed and the joins softened in it. Optional: without it (the replay, or no Pillow on the runner) the browser builds the picture from GIBS as before. Its date is the real_earth layer's covers.date.",
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "made_at", "projection", "sizes", "made_from", "poles", "joins"],
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\d$", "description": "The picture's day (GIBS's day, as NOAA-20 of that date)."},
        "made_at": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d\\+08:00$", "description": "When the engine built it."},
        "projection": {"const": "equirectangular", "description": "West to east from 180 W, north to south from 90 N."},
        "sizes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["width", "height", "webp", "jpg", "bytes"],
            "properties": {
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1},
              "webp": {"type": "string", "pattern": "^earth/real/\\d{4}-\\d\\d-\\d\\d-\\d+\\.webp$"},
              "jpg": {"type": "string", "pattern": "^earth/real/\\d{4}-\\d\\d-\\d\\d-\\d+\\.jpg$"},
              "bytes": {"type": "object", "additionalProperties": false, "required": ["webp", "jpg"],
                        "properties": {"webp": {"type": "integer", "minimum": 1}, "jpg": {"type": "integer", "minimum": 1}}}
            }
          }
        },
        "made_from": {
          "description": "The pictures laid, in order of priority (the first on top): main (NOAA-20 of the date), fill (Suomi NPP and NOAA-21 of the date, NOAA-20 of the day before), base (Blue Marble, no date), pole (NOAA-20 of 7, 14 and 21 days before, over 60 to 90 degrees), cap (each pole's cap: a photo of its date, or Blue Marble). A picture that did not load is not listed.",
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["layer", "date", "role"],
            "properties": {
              "layer": {"type": "string", "minLength": 1},
              "date": {"type": ["string", "null"]},
              "role": {"enum": ["main", "fill", "base", "pole", "cap"]},
              "where": {"enum": ["north", "south"], "description": "For a cap: which pole."}
            }
          }
        },
        "poles": {"const": "completed", "description": "The poles are in the picture (part 107's method); the layer's `poles` field still says which caps."},
        "joins": {
          "type": "object", "additionalProperties": false, "required": ["trim_px", "match_deg", "blend_deg"],
          "properties": {
            "trim_px": {"type": "number", "minimum": 0, "description": "Pixels trimmed off each strip's edge, at the largest size (half that at half the width: the smaller sizes are the largest made smaller)."},
            "match_deg": {"type": "number", "exclusiveMinimum": 0, "description": "The squares, in degrees, in which each filler's colours are matched to the main photo."},
            "blend_deg": {"type": "number", "exclusiveMinimum": 0, "description": "The band, in degrees, over which the main photo fades into the filler from the edge of what it saw."}
          }
        }
      }
    }
  }
}
